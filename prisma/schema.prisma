  generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  kodeUser  String   @unique @map("kode_User") @db.VarChar(20)
  fullname  String
  email     String   @unique
  password  String
  role      String   @default("staff")
  token     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model tbl_facility {
  kode_facility String   @id @db.VarChar(20)
  nama_facility String   @db.VarChar(20)
  create_at     DateTime @default(now()) @db.DateTime(0)
  update_at     DateTime @updatedAt @db.DateTime(0)

  typeUnitFacilities tbl_type_unit_facility[]
}

model tbl_type_unit {
  id_unit_type   Int      @id @default(autoincrement())
  nama_type_unit String   @db.VarChar(100)
  branch_id      Int
  create_at      DateTime @default(now()) @db.DateTime(0)
  update_at      DateTime @updatedAt @db.DateTime(0)

  facilities tbl_type_unit_facility[]
}

model tbl_type_unit_facility {
  id_unit_type  Int
  kode_facility String @db.VarChar(20)

  typeUnit tbl_type_unit @relation(fields: [id_unit_type], references: [id_unit_type], onDelete: Cascade)
  facility tbl_facility @relation(fields: [kode_facility], references: [kode_facility], onDelete: Cascade)

  @@id([id_unit_type, kode_facility])
}
